# ── Nawat Invites configuration ─────────────────────────────
# Public base URL of the app (used in invitation links and QR passes)
APP_URL=http://localhost:3000

# 32+ random bytes, base64. Generate with:  openssl rand -base64 48
# Used to encrypt phone numbers, guest keys and 2FA secrets. Never change it after launch.
APP_SECRET=

# Production: postgres://user:password@host:5432/nawat
# Local development without Postgres: pglite:./.data/db  (embedded Postgres)
DATABASE_URL=pglite:./.data/db

# Where uploaded photos and music are stored
UPLOAD_DIR=./.data/uploads

# Chromium for PDF reports (the Docker image sets this for you)
# CHROMIUM_PATH=/usr/bin/chromium

# First admin account (created by `npm run db:seed`)
SEED_ADMIN_USERNAME=admin
# Leave empty to generate a strong one-time password that is printed once
SEED_ADMIN_PASSWORD=
